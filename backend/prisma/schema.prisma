// Worker Management ERP - Kurti Manufacturing Factory
// Prisma Supabase PostgreSQL Schema Definition

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  MANAGER
  CUTTING_MASTER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum JobCardPriority {
  NORMAL
  HIGH
  URGENT
}

enum JobCardStatus {
  CREATED
  READY_FOR_CUTTING
  CUTTING_IN_PROGRESS
  CUTTING_COMPLETED
}

enum CuttingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum BundleStatus {
  READY_FOR_ASSIGNMENT
  IN_ASSIGNMENT
  COMPLETED
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  SALARY_PENDING
  CANCELLED
}

model User {
  id            String     @id @default(uuid())
  full_name     String
  email         String     @unique
  password_hash String
  role          UserRole   @default(CUTTING_MASTER)
  status        UserStatus @default(ACTIVE)
  last_login    DateTime?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  @@map("users")
}

model Employee {
  id            String         @id @default(uuid())
  employee_code String         @unique
  employee_name String
  phone         String         @unique
  joining_date  DateTime
  status        EmployeeStatus @default(ACTIVE)
  notes         String?
  is_deleted    Boolean        @default(false)
  deleted_at    DateTime?
  deleted_by    String?
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  assignments   Assignment[]
  advances      EmployeeAdvance[]
  payments      EmployeePayment[]

  @@index([status, is_deleted])
  @@map("employees")
}

model JobCard {
  id              String          @id @default(uuid())
  job_card_number String          @unique
  design_code     String
  components      String          @default("Top,Pant")
  stitching_rate  Float           @default(110.0) // Stitching rate per finished piece
  total_quantity  Int
  priority        JobCardPriority @default(NORMAL)
  due_date        DateTime
  status          JobCardStatus   @default(CREATED)
  remarks         String?
  created_by      String?
  is_deleted      Boolean         @default(false)
  deleted_at      DateTime?
  deleted_by      String?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  items            JobCardItem[]
  cutting_progress CuttingProgress[]
  bundles          Bundle[]

  @@index([status, is_deleted])
  @@index([due_date])
  @@map("job_cards")
}

model JobCardItem {
  id          String   @id @default(uuid())
  job_card_id String
  color       String   // Red, Blue, Green, Black, etc.
  size        String   // Dynamic size name
  quantity    Int
  created_at  DateTime @default(now())

  job_card    JobCard  @relation(fields: [job_card_id], references: [id], onDelete: Cascade)

  @@index([job_card_id])
  @@map("job_card_items")
}

model CuttingProgress {
  id           String        @id @default(uuid())
  job_card_id  String
  component    String        // Top, Pant, Top Aster, Pant Aster
  status       CuttingStatus @default(PENDING)
  completed_at DateTime?
  completed_by String?
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  job_card     JobCard       @relation(fields: [job_card_id], references: [id], onDelete: Cascade)

  @@unique([job_card_id, component])
  @@index([job_card_id, status])
  @@map("cutting_progress")
}

model Bundle {
  id             String       @id @default(uuid())
  bundle_number  String       @unique // e.g. 2001-RD-M
  job_card_id    String
  color          String       // Red, Blue, etc.
  size           String       // Dynamic size name
  total_sets     Int
  assigned_sets  Int          @default(0)
  completed_sets Int          @default(0)
  status         BundleStatus @default(READY_FOR_ASSIGNMENT)
  is_deleted     Boolean      @default(false)
  deleted_at     DateTime?
  deleted_by     String?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  job_card       JobCard      @relation(fields: [job_card_id], references: [id], onDelete: Cascade)
  assignments    Assignment[]

  @@index([job_card_id, status, is_deleted])
  @@map("bundles")
}

model Assignment {
  id             String           @id @default(uuid())
  bundle_id      String
  employee_id    String
  assigned_sets  Int
  completed_sets Int              @default(0)
  stitching_rate Float            // Snapshot of JobCard.stitching_rate
  status         AssignmentStatus @default(ASSIGNED)
  assigned_by    String
  remarks        String?
  is_deleted     Boolean          @default(false)
  deleted_at     DateTime?
  deleted_by     String?
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  bundle         Bundle           @relation(fields: [bundle_id], references: [id], onDelete: Cascade)
  employee       Employee         @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  history        AssignmentHistory[]

  @@index([bundle_id, employee_id, status, is_deleted])
  @@map("assignments")
}

model AssignmentHistory {
  id            String     @id @default(uuid())
  assignment_id String
  action        String     // ASSIGNED, PROGRESS_UPDATED, COMPLETED, CANCELLED
  previous_sets Int?
  new_sets      Int?
  performed_by  String
  notes         String?
  created_at    DateTime   @default(now())

  assignment    Assignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)

  @@index([assignment_id])
  @@map("assignment_history")
}

model EmployeeAdvance {
  id           String   @id @default(uuid())
  employee_id  String
  amount       Float
  reason       String?
  advance_date DateTime @default(now())
  created_by   String
  created_at   DateTime @default(now())

  employee     Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id])
  @@map("employee_advances")
}

model EmployeePayment {
  id           String   @id @default(uuid())
  employee_id  String
  amount       Float
  payment_mode String   @default("CASH")
  reference_no String?
  payment_date DateTime @default(now())
  created_by   String
  created_at   DateTime @default(now())

  employee     Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id])
  @@map("employee_payments")
}

model Notification {
  id             String   @id @default(uuid())
  title          String
  message        String
  type           String
  priority       String   @default("MEDIUM") // CRITICAL, HIGH, MEDIUM, LOW
  reference_type String?  // JOB_CARD, BUNDLE, EMPLOYEE, SALARY
  reference_id   String?
  user_role      String   @default("ALL")    // ALL, OWNER, MANAGER, CUTTING_MASTER
  is_read        Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([user_role, is_read])
  @@map("notifications")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  category    String   @default("GENERAL") // COMPANY, FACTORY, EMPLOYEE, JOB_CARD, BUNDLE, SALARY, NOTIFICATION, ROLE
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("system_settings")
}

model GarmentSize {
  id            String   @id @default(uuid())
  size_name     String   @unique
  display_order Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([is_active, display_order])
  @@map("garment_sizes")
}
