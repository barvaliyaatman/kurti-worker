PORT=5000
NODE_ENV=development

# Database Connection (Supabase PostgreSQL / Direct)
DATABASE_URL="postgresql://postgres:[YOUR-DATABASE-PASSWORD]@[YOUR-PROJECT-ID].pooler.supabase.com:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:[YOUR-DATABASE-PASSWORD]@[YOUR-PROJECT-ID].pooler.supabase.com:5432/postgres?schema=public"

# Auth Config
JWT_SECRET="your-super-secret-jwt-key-min-32-characters"
FRONTEND_URL="http://localhost:5173"

# Supabase Credentials
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
